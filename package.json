{
  "name": "private-rental-matching",
  "version": "1.0.0",
  "description": "Privacy-preserving rental property matching platform using FHE encryption",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1221",
    "build": "next build",
    "start": "next start -p 1221",
