    "fhevmjs": "^0.5.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.0.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
